{
  "name": "trust-counting-office",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5178",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4178",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:phaser-core": "node scripts/_phasercoretest.mjs",
    "test:phaser-stock-rollback": "node scripts/_phaserstockrollbacktest.mjs",
    "test:phaser-startup": "node scripts/_phaserstartupmeasure.mjs",
    "test:pwa": "node scripts/_pwaupdatetest.mjs",
    "test:balance": "node scripts/_balancesim.mjs",
    "test:staff": "node scripts/_staffdeploymenttest.mjs",
    "icons:generate": "node scripts/_gen_icons.mjs",
    "screenshots:generate": "node scripts/_pwascreenshots.mjs",
    "fonts:subset": "node scripts/_subsetfonts.mjs",
    "phaser:build": "node tools/phaser/build-custom-phaser.mjs",
    "phaser:check": "node tools/phaser/assert-custom-phaser.mjs",
    "phaser:prepare": "node tools/phaser/prepare-phaser.mjs",
    "prebuild": "npm run fonts:subset && npm run phaser:prepare",
    "build:android": "npm run build && cap copy android",
    "android:open": "cap open android",
    "android:sync": "npm run build && cap sync android",
    "android:bundle": "npm run android:sync && cd android && ./gradlew --no-daemon clean bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "firebase": "^12.17.1",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "esbuild": "0.28.1",
    "playwright": "^1.62.1",
    "subset-font": "^2.5.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
